# Salin file ini menjadi .env.local lalu isi nilainya. JANGAN commit .env.local.
# Di Vercel: Project Settings > Environment Variables (isi 3 variabel yang sama).

# API key dari dashboard Resend (diawali "re_")
RESEND_API_KEY=

# Email tujuan pesan (untuk akun Resend gratis tanpa domain: harus email akun Resend-mu)
CONTACT_TO_EMAIL=

# Opsional. Biarkan kosong untuk memakai pengirim bawaan Resend.
# CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
